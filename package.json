{
  "name": "sage-app",
  "version": "0.1.5",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "index-corpus": "python scripts/build_index.py",
    "electron:prepare": "node scripts/electron-prepare.mjs",
    "electron:dist": "node scripts/electron-prepare.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish=never",
    "electron:dist:win": "node scripts/electron-prepare.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish=never",
    "electron:dist:linux": "node scripts/electron-prepare.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --publish=never",
    "electron:dist:mac": "node scripts/electron-prepare.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish=never"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "next": "14.2.5",
    "pdfjs-dist": "^6.1.200",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alacle.sage",
    "productName": "Sage",
    "copyright": "Copyright © 2024 Alacle",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "generic",
      "url": "https://forge.apps.education.fr/api/v4/projects/17880/packages/generic/sage/latest"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sage"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/maskable-512.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon-512.png",
      "category": "Education"
    },
    "artifactName": "Sage-${version}-${os}.${ext}"
  }
}
